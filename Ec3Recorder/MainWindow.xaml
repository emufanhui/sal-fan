<Window x:Class="Ec3Recorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpatialAudioLab E-AC3 录制器"
        Width="720" Height="620" MinWidth="640" MinHeight="560"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="E-AC3 录制器" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="CliPathText" Margin="0,4,0,0" FontSize="12"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Live stream state -->
        <Border Grid.Row="1" Padding="18" Margin="0,0,0,14"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="SignalLamp" Grid.Column="0"
                         Width="20" Height="20" Margin="0,0,16,0"
                         VerticalAlignment="Center" Fill="#FF5A6272" />

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="SignalText" Text="未检测到流" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="SignalDetail" Margin="0,4,0,0" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Recording control -->
        <Border Grid.Row="2" Padding="18" Margin="0,0,0,14"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <!-- Current Apple Music track and split switch -->
                <Border Background="#FF14171D" Padding="12,9" Margin="0,0,0,14" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="当前曲目（Apple Music）" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="TrackText" Text="—" Margin="0,3,0,0" FontSize="13"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <CheckBox x:Name="AutoSplitCheck" Grid.Column="1" Content="按曲目自动分轨"
                                  IsChecked="True" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Text="输出文件" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                <Grid Margin="0,6,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputPathBox" Grid.Column="0"
                             Padding="8,6" FontSize="13"
                             Background="#FF14171D" Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" />
                    <Button Grid.Column="1" Content="浏览..." Margin="10,0,0,0" Padding="14,6"
                            Click="OnBrowseClick" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="StartButton" Grid.Column="0" Content="开始录制"
                            Padding="22,9" FontWeight="SemiBold"
                            Background="{StaticResource AccentBrush}" Foreground="White"
                            BorderThickness="0" Click="OnStartClick" />
                    <Button x:Name="StopButton" Grid.Column="1" Content="停止录制"
                            Margin="10,0,0,0" Padding="22,9" IsEnabled="False"
                            Click="OnStopClick" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="时长" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="DurationText" Text="00:00" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="E-AC3 帧" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="FramesText" Text="0" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="大小" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="SizeText" Text="0 MB" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Log -->
        <Border Grid.Row="3" Padding="12"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="8">
            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource MutedBrush}"
                     FontFamily="Consolas" FontSize="12" />
        </Border>
    </Grid>
</Window>
