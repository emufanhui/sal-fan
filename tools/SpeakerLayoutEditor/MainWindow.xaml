<Window x:Class="SpeakerLayoutEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpatialAudioLab Studio" Width="1440" Height="760"
        WindowStartupLocation="CenterScreen"
        MinWidth="1180" MinHeight="640" Background="#F3F5F6"
        FontFamily="Microsoft YaHei UI" FontSize="13">
  <Window.Resources>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#4B535A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="SegmentButton" TargetType="RadioButton">
      <Setter Property="Height" Value="34" />
      <Setter Property="Foreground" Value="#252A2E" />
      <Setter Property="Background" Value="#E7EBED" />
      <Setter Property="BorderBrush" Value="#B8C0C5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="SegmentBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SegmentBorder" Property="Background" Value="#D8DEE2" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SegmentBorder" Property="Background" Value="#3478A5" />
                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="#286589" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="SegmentBorder" Property="Opacity" Value="0.65" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Margin" Value="0,4,0,12" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#252A2E" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Height="54" Background="#252B30"
            BorderBrush="#161A1D" BorderThickness="0,0,0,1">
      <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Style="{StaticResource IconButton}" Content="&#xE8E5;"
                ToolTip="打开配置" Click="OpenClick" />
        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE74E;"
                ToolTip="保存配置" Click="SaveClick" />
        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE792;"
                ToolTip="另存为" Click="SaveAsClick" />
        <TextBlock Grid.Column="4" x:Name="PathText" Foreground="#DCE1E4"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="5" Text="7.1.4" Foreground="#9FD4B2" FontWeight="SemiBold"
                   VerticalAlignment="Center" FontSize="15" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Height="30" Background="#E2E6E8"
            BorderBrush="#C7CDD1" BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusText" Margin="12,0" VerticalAlignment="Center"
                 Text="就绪" />
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="500" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#E9EDEF" BorderBrush="#C9CFD3"
              BorderThickness="0,0,1,0">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" Text="扬声器" FontSize="11"
                     Foreground="#596168" FontWeight="SemiBold" Margin="4,4,0,8" />
          <ListBox x:Name="SpeakerList" BorderThickness="0" Background="Transparent"
                   SelectionChanged="SpeakerSelectionChanged"
                   DisplayMemberPath="Name" />
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="18,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="190" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="4,0,4,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="LayoutNameText" FontSize="20" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" x:Name="RouteLegend" Orientation="Horizontal"
                      VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="1" Background="White" BorderBrush="#C9CFD3" BorderThickness="1">
          <Canvas x:Name="TopCanvas" ClipToBounds="True"
                  SizeChanged="CanvasSizeChanged"
                  MouseMove="CanvasMouseMove"
                  MouseLeftButtonUp="CanvasMouseUp" />
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="仰角" FontSize="11" Foreground="#596168"
                     FontWeight="SemiBold" Margin="4,0,0,6" />
          <Border Grid.Row="1" Background="White" BorderBrush="#C9CFD3" BorderThickness="1">
            <Canvas x:Name="ElevationCanvas" ClipToBounds="True"
                    SizeChanged="CanvasSizeChanged"
                    MouseMove="CanvasMouseMove"
                    MouseLeftButtonUp="CanvasMouseUp" />
          </Border>
        </Grid>
      </Grid>

      <Border Grid.Column="2" Background="#FAFBFB" BorderBrush="#C9CFD3"
              BorderThickness="1,0,0,0">
        <TabControl Background="Transparent" BorderThickness="0" Margin="12">
          <TabItem Header="扬声器">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="6,16,6,6">
                <TextBlock x:Name="SelectedNameText" FontSize="18" FontWeight="SemiBold"
                           Margin="0,0,0,18" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="方位角" />
                  <TextBlock Grid.Column="1" x:Name="AzimuthValue" TextAlignment="Right" />
                </Grid>
                <Slider x:Name="AzimuthSlider" Minimum="-180" Maximum="180"
                        ValueChanged="SpeakerControlChanged" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="仰角" />
                  <TextBlock Grid.Column="1" x:Name="ElevationValue" TextAlignment="Right" />
                </Grid>
                <Slider x:Name="ElevationSlider" Minimum="-30" Maximum="90"
                        ValueChanged="SpeakerControlChanged" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="电平" />
                  <TextBlock Grid.Column="1" x:Name="TrimValue" TextAlignment="Right" />
                </Grid>
                <Slider x:Name="TrimSlider" Minimum="-24" Maximum="12"
                        ValueChanged="SpeakerControlChanged" />
                <TextBlock Text="物理输出" Margin="0,4,0,6" />
                <ComboBox x:Name="PhysicalDestinationCombo" DisplayMemberPath="DisplayName"
                          SelectionChanged="PhysicalDestinationSelectionChanged" Height="30"
                          ToolTip="播放此扬声器声音的音频端点和物理通道" />
                <TextBlock x:Name="DestinationEndpointText" Margin="2,5,2,0"
                           Foreground="#596168" TextWrapping="Wrap"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Button Height="36" Margin="0,14,0,0" Click="ResetPositionsClick"
                        ToolTip="将所有扬声器的方位角和仰角恢复为默认值">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE777;"
                               FontSize="15" Margin="0,0,8,0" />
                    <TextBlock Text="重置扬声器位置" />
                  </StackPanel>
                </Button>
                <TextBlock Text="测试增益" Margin="0,14,0,2" />
                <Slider x:Name="TestGainSlider" Minimum="0" Maximum="0.25" Value="0.08" />
                <Button Height="38" Margin="0,10,0,0" Click="TestSpeakerClick"
                        HorizontalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE768;"
                               FontSize="16" Margin="0,0,8,0" />
                    <TextBlock Text="测试扬声器" />
                  </StackPanel>
                </Button>
                <TextBlock Text="低音管理（分频）" Margin="0,18,0,4"
                           FontSize="13" FontWeight="SemiBold"
                           ToolTip="按声道布局把各声道的低频汇总到低音炮声道，参数存在所选的 dsp.json 里。" />
                <!-- 低音管理：可选的分频，把各声道低频汇总到低音炮 -->
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="DspEnabledBox" Content="启用低音管理"
                            VerticalAlignment="Center"
                            Checked="DspEnabledChanged" Unchecked="DspEnabledChanged"
                            ToolTip="把各声道的低频汇总到低音炮声道。用到的就是下面那份 json；声道数或块长与链路不符时引擎会旁路并在日志里写明。" />
                  <Button Grid.Column="1" x:Name="DspPickButton" Content="选择配置…"
                          HorizontalAlignment="Right" Padding="10,4"
                          Click="PickDspConfigClick"
                          ToolTip="挑一份 dsp.json 来用，可以是 AggregateASIO 正在用的那一份。Studio 只读它的内容，自己的开关存在便携目录里，不会写进这个文件。" />
                </Grid>

                <TextBlock x:Name="DspConfigPathText" Margin="0,4,0,0" FontSize="11"
                           Foreground="#59636A" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                <TextBlock x:Name="DspSummary" Margin="0,2,0,0" FontSize="11"
                           Foreground="#59636A" TextWrapping="Wrap" />

                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="低音汇入" VerticalAlignment="Center" FontSize="11"
                             ToolTip="各声道低通汇总进 LFE 时的增益，对应 json 里的 bassGain。" />
                  <TextBox Grid.Column="1" x:Name="DspBassGainBox" Margin="6,0,0,0"
                           Text="-12" VerticalContentAlignment="Center"
                           LostFocus="DspNumbersChanged"
                           ToolTip="单位 dB。" />
                  <TextBlock Grid.Column="2" Text="LFE 微调" Margin="12,0,0,0"
                             VerticalAlignment="Center" FontSize="11"
                             ToolTip="叠加到 LFE 声道上的增益，对应 json 里的 lfeTrim。" />
                  <TextBox Grid.Column="3" x:Name="DspLfeTrimBox" Margin="6,0,0,0"
                           Text="0" VerticalContentAlignment="Center"
                           LostFocus="DspNumbersChanged"
                           ToolTip="单位 dB。" />
                </Grid>

                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="声道" FontSize="10" Foreground="#59636A" />
                  <TextBlock Grid.Column="1" Text="LFE" FontSize="10"
                             Foreground="#59636A" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="分频Hz" FontSize="10"
                             Foreground="#59636A" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="延时ms" FontSize="10"
                             Foreground="#59636A" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="增益dB" FontSize="10"
                             Foreground="#59636A" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="5" Text="反相" FontSize="10"
                             Foreground="#59636A" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="6" Text="PEQ（freq:gain:q，多段用逗号分隔）"
                             FontSize="10" Foreground="#59636A" Margin="6,0,0,0" />
                </Grid>

                <ItemsControl x:Name="DspChannelList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="40" />
                          <ColumnDefinition Width="30" />
                          <ColumnDefinition Width="56" />
                          <ColumnDefinition Width="56" />
                          <ColumnDefinition Width="56" />
                          <ColumnDefinition Width="32" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                   FontSize="11" />
                        <CheckBox Grid.Column="1" IsChecked="{Binding IsLfe, Mode=TwoWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  ToolTip="这个声道收集低音。一份配置里应当只有一个。" />
                        <TextBox Grid.Column="2" Margin="2,0" FontSize="11"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Crossover, Mode=TwoWay,
                                        UpdateSourceTrigger=LostFocus}" />
                        <TextBox Grid.Column="3" Margin="2,0" FontSize="11"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding DelayMs, Mode=TwoWay,
                                        UpdateSourceTrigger=LostFocus}" />
                        <TextBox Grid.Column="4" Margin="2,0" FontSize="11"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding GainDb, Mode=TwoWay,
                                        UpdateSourceTrigger=LostFocus}" />
                        <CheckBox Grid.Column="5" IsChecked="{Binding Invert, Mode=TwoWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  ToolTip="极性取反。" />
                        <Grid Grid.Column="6" Margin="6,0,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBox Margin="2,0" FontSize="11"
                                   VerticalContentAlignment="Center"
                                   Text="{Binding Peq, Mode=TwoWay,
                                          UpdateSourceTrigger=LostFocus}" />
                          <TextBlock Grid.Column="1" Text="{Binding PeqHint}" FontSize="10"
                                     Foreground="#59636A" Margin="6,0,0,0"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="DspSaveButton" Content="保存到配置" Padding="10,4"
                          Click="SaveDspConfigClick"
                          ToolTip="把上面的参数写回这份 json，下一次起桥时生效。" />
                  <Button Grid.Column="1" x:Name="DspSaveAsButton" Content="另存为…"
                          Padding="10,4" Margin="8,0,0,0" Click="SaveDspConfigAsClick" />
                  <Button Grid.Column="3" x:Name="DspRebuildButton" Content="按当前布局重建"
                          Padding="10,4" Click="RebuildDspConfigClick"
                          ToolTip="丢掉当前参数，按当前布局的声道名与顺序重新生成一份。" />
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="输出">
            <Grid Margin="4,12,4,4">
              <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="活动音频端点" FontSize="11" Foreground="#596168"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="RefreshEndpointsButton" Width="30" Height="28"
                        FontFamily="Segoe Fluent Icons" FontSize="14" Content="&#xE72C;"
                        ToolTip="刷新音频端点" Click="RefreshEndpointsClick" />
              </Grid>
              <DataGrid Grid.Row="1" x:Name="OutputGrid" AutoGenerateColumns="False"
                        CanUserAddRows="False" CanUserDeleteRows="False"
                        HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="38"
                        ColumnHeaderHeight="30" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="路由" Binding="{Binding Name}" IsReadOnly="True"
                                      Width="78" />
                  <DataGridTemplateColumn Header="音频端点" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ComboBox ItemsSource="{Binding EndpointChoices,
                                    RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Filter"
                                  SelectedValue="{Binding Endpoint, Mode=OneWay}"
                                  SelectionChanged="EndpointSelectionChanged"
                                  ToolTip="{Binding Endpoint}" Height="28"
                                  VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="ms" Binding="{Binding DelayMilliseconds}"
                                      Width="48" />
                  <DataGridTemplateColumn Header="通道映射" Width="118" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding ChannelMapText}" ToolTip="{Binding ChannelMapText}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
          <TabItem Header="桥接">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="8,18,8,8">
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="34" />
                  </Grid.RowDefinitions>
                  <RadioButton x:Name="MatModeButton" Style="{StaticResource SegmentButton}"
                               GroupName="BridgeMode" IsChecked="True" Content="Atmos (Windows)"
                               Click="BridgeModeClick"
                               ToolTip="通过 Windows 空间音频使用 Dolby Atmos" />
                  <RadioButton Grid.Column="2" x:Name="DtsXModeButton"
                               Style="{StaticResource SegmentButton}" GroupName="BridgeMode"
                               Content="DTS:X" Click="BridgeModeClick" />
                  <RadioButton Grid.Row="2" x:Name="NativeMatModeButton"
                               Style="{StaticResource SegmentButton}" GroupName="BridgeMode"
                               Content="原生 MAT（BF1）" Click="BridgeModeClick"
                               ToolTip="禁用 Windows 空间音频后直接输出 MAT 载波" />
                  <RadioButton Grid.Row="2" Grid.Column="2" x:Name="PcmModeButton"
                               Style="{StaticResource SegmentButton}" GroupName="BridgeMode"
                               Content="PCM 7.1.4" Click="BridgeModeClick"
                               ToolTip="使用内置渲染器，不经过 Dolby 或 DTS 编码器" />
                  <RadioButton Grid.Row="4" x:Name="NspModeButton"
                               Style="{StaticResource SegmentButton}" GroupName="BridgeMode"
                               Content="NSP 7.1.4（免驱动）" Click="BridgeModeClick"
                               ToolTip="由 NativeSpatialPipe 采集 Windows 空间音频，经共享内存送入，无需虚拟声卡" />
                  <RadioButton Grid.Row="4" Grid.Column="2" x:Name="Eac3ModeButton"
                               Style="{StaticResource SegmentButton}" GroupName="BridgeMode"
                               Content="接收 E-AC-3" Click="BridgeModeClick"
                               ToolTip="从驱动的 IEC 61937 载波里剥出 E-AC-3，用 Cavern 解码并渲染 7.1.4，经 Local\SAL_EAC3_PCM714 送入" />
                </Grid>

                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse x:Name="BridgeStatusDot" Width="10" Height="10"
                           Fill="#8B949A" HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" x:Name="BridgeStatusText" Text="检查中..."
                             FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="延迟" FontSize="11" FontWeight="SemiBold"
                           Foreground="#59636A" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <RadioButton x:Name="SafeLatencyButton" Style="{StaticResource SegmentButton}"
                               GroupName="BridgeLatency" Content="稳定"
                               ToolTip="默认周期，预缓冲 80 ms"
                               Checked="BridgeLatencyChecked" />
                  <RadioButton Grid.Column="2" x:Name="BalancedLatencyButton"
                               Style="{StaticResource SegmentButton}" GroupName="BridgeLatency"
                               Content="均衡" IsChecked="True"
                               ToolTip="中等周期，预缓冲 40 ms"
                               Checked="BridgeLatencyChecked" />
                  <RadioButton Grid.Column="4" x:Name="LowLatencyButton"
                               Style="{StaticResource SegmentButton}" GroupName="BridgeLatency"
                               Content="低延迟" ToolTip="最小周期，预缓冲 20 ms"
                               Checked="BridgeLatencyChecked" />
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="增益" />
                  <TextBlock Grid.Column="1" x:Name="BridgeGainValue" TextAlignment="Right" />
                </Grid>
                <Slider x:Name="BridgeGainSlider" Minimum="0" Maximum="1" Value="0.25"
                        TickFrequency="0.01" ValueChanged="BridgeControlChanged" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="预缓冲" />
                  <TextBlock Grid.Column="1" x:Name="BridgePrebufferValue" TextAlignment="Right" />
                </Grid>
                <Slider x:Name="BridgePrebufferSlider" Minimum="20" Maximum="500" Value="40"
                        TickFrequency="10" IsSnapToTickEnabled="True"
                        ValueChanged="BridgeControlChanged" />

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="BridgeStartButton" Height="42" Click="StartBridgeClick">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE768;"
                                 FontSize="16" Margin="0,0,8,0" />
                      <TextBlock x:Name="BridgeStartText" Text="启动" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2" x:Name="BridgeStopButton" Height="42"
                          Click="StopBridgeClick" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE71A;"
                                 FontSize="16" Margin="0,0,8,0" />
                      <TextBlock Text="停止" />
                    </StackPanel>
                  </Button>
                </Grid>

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
